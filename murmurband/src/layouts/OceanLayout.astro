---
import SocialLinks from '../components/SocialLinks.astro';
import SiteLayout from './SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/ocean.css';
interface Props { title: string; background?: string; }
const { title, background = '/1.jpg' } = Astro.props;
---
<SiteLayout title={title}>
  <a class="skip-link" href="#page-content">跳至主要內容</a>
  <div class="ocean-atmosphere" style={`--page-background: url("${background}")`} aria-hidden="true"></div>
  <SiteHeader background={background} />
  <div><slot /></div>
  <footer class="ocean-footer">
    <a href="/">© {new Date().getFullYear()} 自言自語 MURMUR</a>
    <SocialLinks />
  </footer>
</SiteLayout>

<script>
  const panel = document.querySelector<HTMLElement>('.record-panel');
  if (panel) {
    const updateStickyOffset = () => {
      const headerGap = window.innerWidth <= 760 ? 92 : 104;
      const top = Math.min(headerGap, window.innerHeight - panel.offsetHeight - 24);
      panel.style.setProperty('--record-sticky-top', `${top}px`);
    };
    // Recalculate after cover images, fonts, and responsive text change its height.
    new ResizeObserver(updateStickyOffset).observe(panel);
    window.addEventListener('resize', updateStickyOffset);
    updateStickyOffset();
  }
</script>
