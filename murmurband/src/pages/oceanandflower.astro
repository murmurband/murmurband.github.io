---
import OceanLayout from "../layouts/OceanLayout.astro";
import releases from "../data/releases.json";
const release = releases.find((item) => item.slug === "oceanandflower")!;
const songUrl =
  "https://packer-sys.streetvoice.com/zh-hant/packerlink/bLWv9UdX8x/";
---

<OceanLayout title={release.title + " · Murmur"}>
  <main id="page-content" tabindex="-1" class="lyrics-page">
    <aside class="record-panel">
      <a class="back-link" lang="en" href="/works.html">← All works</a>
      <a
        class="record-cover-link"
        href={songUrl}
        aria-label={release.title + " — 聆聽歌曲"}
      >
        <img
          class="record-cover"
          src={release.image}
          alt={release.title + " 封面"}
        />
      </a>
      <p class="record-title"><a href={songUrl}>{release.title}</a></p>
      {
        release.english !== release.title && (
          <p class="record-name" lang="en">
            {release.english}
          </p>
        )
      }
      <p class="eyebrow">{release.date}</p>
      <div class="st_composer">
        作詞：施柏年 Marcus Shih・作曲：施柏年 Marcus Shih／詹于萱 Naomi Chan
      </div>
      <div class="st_artist">
        編曲 Arranger｜施柏年 Marcus Shih
        <br />主唱 Vocalist｜盧瑞珍 Jane Lu／施柏年 Marcus Shih
        <br />木吉他 Acoustic Guitarist｜施柏年 Marcus Shih
        <br />電吉他 Electric Guitarist｜施柏年 Marcus Shih
        <br />貝斯 Bassist｜施柏年 Marcus Shih
        <br />合成器 Synth｜施柏年 Marcus Shih
        <br />鼓組 Drummer｜李啟綸 Lawrence Lee from 300ss音樂劇場
        <br />
        <br />
      </div>
    </aside>
    <article class="lyrics-content">
      <div class="st">
        <h1><a class="st_title" href={songUrl}>{release.title}</a></h1>

        <div class="st_text">
          親愛的你 過得還好嗎
          <br />我把思念融進了日常
          <br />開始重複你說的話
          <br />眺望著有你的遠方
          <br />漸漸暈開的盛夏
          <br />
          <br />親愛的妳 今天還好嗎
          <br />是否依然故作堅強
          <br />想跨越無垠的海洋
          <br />循著妳心底的方向
          <br />用旋律穿越到妳的身旁
          <br />
          <br />在蔚藍的海邊開一朵鮮花
          <br />所有帶不走的到了這裡 就先停下
          <br />溫柔的倔強
          <br />就算總是差一點勇敢
          <br />哪怕眼淚又再次落下
          <br />淹不過你的芬芳 永恆的綻放
          <br />
          <br />再跨越無垠的海洋
          <br />循著你留下的微光
          <br />轉眼就穿越到你的身旁
          <br />
          <br />在蔚藍的海邊開一朵鮮花
          <br />所有帶不走的到了這裡 就先停下
          <br />溫柔的倔強
          <br />就算總是差一點勇敢
          <br />哪怕眼淚又再次落下
          <br />淹不過你的芬芳 永恆的綻放

          <br />我愛你呀

          <br />
          <br />
        </div>
      </div>
      <a class="back-link lyrics-back" lang="en" href="/works.html"
        >← All works</a
      >
    </article>
  </main>
</OceanLayout>
