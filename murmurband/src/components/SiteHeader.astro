---
interface Props {
  home?: boolean;
  background?: string;
}
const { home = false, background = "/1.jpg" } = Astro.props;
const path = Astro.url.pathname;
---

<header
  style={`--page-background: url("${background}")`}
  class:list={["site-header", { "site-header-home": home }]}
>
  {home && <button class="opening-replay" type="button" lang="en"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6" /></svg><span>Replay opening</span></button>}
  {
    !home && (
      <a class="site-brand" href="/" aria-label="Murmur 首頁">
        <img
          src="/Murmur-logo-text.png"
          alt="Murmur"
          width="1472"
          height="374"
        />
      </a>
    )
  }
  <nav aria-label="Main navigation" lang="en">
    <a
      href="/story.html"
      aria-current={path.startsWith("/story") ? "page" : undefined}>Story</a
    >
    <a
      href="/works.html"
      aria-current={path.startsWith("/works") ? "page" : undefined}>Works</a
    >
    <a
      href="https://linktr.ee/murmurband_?utm_source=linktree_profile_share&ltsid=f223bfbf-0435-4904-9b14-59e297adc366"
      aria-label="Contact Murmur"
      >Contact <span aria-hidden="true">↗</span></a
    >
  </nav>
</header>
{!home && <div class="header-space" aria-hidden="true" />}

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    let anchor = Math.max(0, window.scrollY);
    let scheduled = false;
    const update = () => {
      const y = Math.max(
        0,
        Math.min(
          window.scrollY,
          document.documentElement.scrollHeight - window.innerHeight
        )
      );
      header.classList.toggle("is-scrolled", y > 16);
      if (y <= 2 || header.contains(document.activeElement)) {
        header.classList.remove("is-hidden");
        anchor = y;
      } else if (Math.abs(y - anchor) >= (y > anchor ? 3 : 8)) {
        header.classList.toggle("is-hidden", y > anchor);
        anchor = y;
      }
      scheduled = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!scheduled) {
          scheduled = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    header.addEventListener("focusin", () =>
      header.classList.remove("is-hidden")
    );
    window.addEventListener("pageshow", update);
    update();
  }
</script>

<style>
  .opening-replay {
    margin-right: auto;
    flex-shrink: 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: 12px/20px 'Shippori Mincho', serif;
    letter-spacing: .12em;
    cursor: pointer;
  }
  .opening-replay span { position: relative; }
  .opening-replay span::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -7px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }
  .opening-replay:hover span::after,
  .opening-replay:focus-visible span::after { transform: scaleX(1); }
  @media (max-width: 760px) {
    .opening-replay { padding: 7px 0; gap: 5px; font-size: 10px; letter-spacing: .04em; }
    .site-header-home { gap: 10px; }
    .site-header-home nav { gap: 14px; letter-spacing: .08em; }
  }
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 4;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 80px;
    padding: 0 var(--page-gutter);
    gap: 20px;
    background-color: transparent;
    isolation: isolate;
    overflow: visible;
    animation: none;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Fade the backdrop only; keep the logo and navigation fully opaque. */
  .site-header::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--sea);
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }
  .site-header.is-scrolled::before {
    opacity: 0.96;
  }
  .header-space {
    height: 80px;
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .site-header:focus-within {
    transform: translateY(0);
  }
  .site-brand {
    position: relative;
    width: 135px;
    aspect-ratio: 1384 / 242;
    flex-shrink: 0;
    margin-right: auto;
    /* Optical alignment with the menu glyphs, below the line-box center. */
    transform: translateY(5%);
  }
  .site-brand img {
    position: absolute;
    width: 106.36%;
    max-width: none;
    height: auto;
    left: -3.47%;
    top: -27.27%;
    display: block;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    justify-content: flex-end;
    gap: 36px;
    font-size: 12px;
    line-height: 20px;
    letter-spacing: 0.2em;
    white-space: nowrap;
  }
  nav a {
    position: relative;
    padding: 7px 0;
    border-bottom: 1px solid transparent;
  }
  nav a::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }
  nav a:hover::after,
  nav a:focus-visible::after,
  nav [aria-current="page"]::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    nav a::after,
    .site-header,
    .site-header::before {
      transition: none;
    }
  }
  @media (max-width: 760px) {
    .site-header {
      height: auto;
      min-height: 68px;
      padding: 0 var(--page-gutter);
    }
    .header-space {
      height: 68px;
    }
    .site-brand {
      width: 100px;
    }
    nav {
      gap: 25px;
      font-size: 11px;
    }
  }
  @media (max-width: 380px) {
    .site-header {
      gap: 12px;
    }
    .site-brand {
      width: 85px;
    }
    nav {
      gap: 16px;
      letter-spacing: 0.1em;
    }
  }
</style>
