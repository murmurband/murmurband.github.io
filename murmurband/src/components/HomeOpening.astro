<div class="home-opening" hidden role="dialog" aria-modal="true" aria-label="Murmur 開場">
  <video class="opening-ocean" muted playsinline loop preload="none" aria-hidden="true">
    <source data-src="/ocean-back.mp4" type="video/mp4" />
  </video>
  <div class="opening-shade" aria-hidden="true"></div>
  <img class="opening-logo" src="/Murmur-logo-text-hollow.png" alt="Murmur" />
  <button class="opening-skip" type="button" lang="en">Skip intro</button>
</div>

<script is:inline>
  (() => {
    const opening = document.querySelector('.home-opening');
    const shell = document.querySelector('.home-shell');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!opening || !shell) return;
    const replay = document.querySelector('.opening-replay');
    const video = opening.querySelector('video');
    const source = video.querySelector('source');
    let timer;
    let revealTimer;
    let active = false;
    const reveal = () => {
      if (!active || opening.classList.contains('is-leaving')) return;
      clearTimeout(revealTimer);
      opening.classList.add('is-leaving');
      document.documentElement.classList.add('opening-complete');
      clearTimeout(timer);
      timer = window.setTimeout(finish, motion.matches ? 0 : 1200);
    };
    const finish = () => {
      if (!active) return;
      active = false;
      const restoreFocus = opening.contains(document.activeElement);
      clearTimeout(timer);
      clearTimeout(revealTimer);
      video.pause();
      opening.hidden = true;
      shell.inert = false;
      document.documentElement.classList.remove('opening-active');
      document.documentElement.classList.add('opening-complete');
      document.removeEventListener('keydown', onKey);
      motion.removeEventListener('change', finish);
      window.removeEventListener('pagehide', finish);
      if (restoreFocus) shell.querySelector('a, button')?.focus({ preventScroll: true });
    };
    const onKey = (event) => {
      if (event.key === 'Escape') reveal();
      if (event.key === 'Tab') {
        event.preventDefault();
        opening.querySelector('button').focus();
      }
    };

    const start = () => {
      if (active) return;
      active = true;
      try { localStorage.setItem('murmur-opening-seen', '1'); } catch {}
      try { sessionStorage.setItem('murmur-opening-seen', '1'); } catch {}
      document.documentElement.classList.remove('opening-complete');
      opening.hidden = true;
      opening.classList.remove('is-leaving');
      // Commit the reset so every replay starts fresh CSS animations.
      void shell.offsetWidth;
      shell.inert = true;
      window.scrollTo({ top: 0, behavior: 'instant' });
      document.documentElement.classList.add('opening-active');
      document.documentElement.classList.remove('opening-pending');
      opening.hidden = false;
      opening.querySelector('button').focus({ preventScroll: true });
      video.muted = true;
      if (!source.src) {
        source.src = source.dataset.src;
        video.load();
      }
      video.currentTime = 0;
      if (!motion.matches) video.play().catch(() => {});
      document.addEventListener('keydown', onKey);
      motion.addEventListener('change', finish);
      window.addEventListener('pagehide', finish);
      // Reveal the solid home logo underneath as the hollow opening fades away.
      revealTimer = window.setTimeout(reveal, 3000);
      timer = window.setTimeout(finish, 4300);
    };
    replay?.addEventListener('click', start);
    opening.querySelector('button').addEventListener('click', reveal);
    opening.addEventListener('animationend', (event) => {
      if (event.target === opening && event.animationName === 'opening-reveal') finish();
    });
    if (document.documentElement.classList.contains('opening-pending') && !motion.matches) {
      start();
    } else {
      document.documentElement.classList.remove('opening-pending');
    }
  })();
</script>

<style>
  :global(html.opening-active) { overflow: hidden; }
  :global(html.opening-pending .home-shell),
  :global(html.opening-active:not(.opening-complete) .home-shell) { visibility: hidden; }
  :global(html.opening-complete .home-shell) { visibility: visible; }
  .home-opening {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    isolation: isolate;
    background: #082634;
  }
  .home-opening.is-leaving { animation: opening-reveal 1.1s ease-in-out both; }
  .home-opening[hidden] { display: none; }
  .opening-ocean, .opening-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .opening-ocean { object-fit: cover; filter: saturate(.65) brightness(.7); z-index: -2; }
  .opening-shade { background: linear-gradient(180deg, #061b3540, #06283718 45%, #051c3866); z-index: -1; }
  .opening-logo { position: absolute; left: 50%; top: 50svh; transform: translate(-50%, -50%); width: var(--home-logo-width); aspect-ratio: 1472 / 374; height: auto; animation: opening-logo .8s .2s ease-in-out both; }
  .opening-skip {
    position: absolute;
    right: max(6%, env(safe-area-inset-right));
    bottom: max(32px, env(safe-area-inset-bottom));
    min-height: 44px;
    padding: 10px 8px;
    border: 0;
    background: transparent;
    color: #e2edf3;
    font: 11px 'Shippori Mincho', serif;
    letter-spacing: normal;
    cursor: pointer;
  }
  .home-opening .opening-skip:focus-visible {
    outline: none;
    text-decoration: none;
  }
  @keyframes opening-logo {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes opening-reveal {
    0% { opacity: 1; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-opening { animation: none; }
    .opening-logo, .opening-ocean { animation: none; }
  }
</style>
