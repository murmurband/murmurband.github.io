<div class="home-opening" hidden role="dialog" aria-modal="true" aria-label="Murmur 開場">
  <video class="opening-ocean" muted playsinline loop preload="none" aria-hidden="true">
    <source data-src="/ocean-back.mp4" type="video/mp4" />
  </video>
  <div class="opening-shade" aria-hidden="true"></div>
  <img class="opening-logo" src="/Murmur-logo-text.png" alt="Murmur" />
  <button class="opening-skip" type="button" lang="en">Skip intro <span aria-hidden="true">↗</span></button>
</div>

<script is:inline>
  (() => {
    const opening = document.querySelector('.home-opening');
    const shell = document.querySelector('.home-shell');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let seen = false;
    try { seen = localStorage.getItem('murmur-opening-seen') === '1'; } catch {}
    try { seen = seen || sessionStorage.getItem('murmur-opening-seen') === '1'; } catch {}
    if (!opening || !shell || seen || motion.matches ||
        !document.documentElement.classList.contains('opening-pending')) {
      document.documentElement.classList.remove('opening-pending');
      return;
    }
    // Remember immediately, including when the visitor skips or leaves early.
    try { localStorage.setItem('murmur-opening-seen', '1'); } catch {}
    try { sessionStorage.setItem('murmur-opening-seen', '1'); } catch {}

    const video = opening.querySelector('video');
    const source = video.querySelector('source');
    let timer;
    const finish = () => {
      const restoreFocus = opening.contains(document.activeElement);
      clearTimeout(timer);
      video.pause();
      opening.hidden = true;
      shell.inert = false;
      document.documentElement.classList.remove('opening-active');
      document.documentElement.classList.add('opening-complete');
      document.removeEventListener('keydown', onKey);
      motion.removeEventListener('change', finish);
      window.removeEventListener('pagehide', finish);
      if (restoreFocus) shell.querySelector('a, button')?.focus({ preventScroll: true });
    };
    const onKey = (event) => {
      if (event.key === 'Escape') finish();
      if (event.key === 'Tab') {
        event.preventDefault();
        opening.querySelector('button').focus();
      }
    };

    shell.inert = true;
    document.documentElement.classList.add('opening-active');
    document.documentElement.classList.remove('opening-pending');
    opening.hidden = false;
    opening.querySelector('button').focus({ preventScroll: true });
    video.muted = true;
    source.src = source.dataset.src;
    video.load();
    video.play().catch(() => { /* Keep the plain ocean-colored backdrop if autoplay is unavailable. */ });
    opening.querySelector('button').addEventListener('click', finish);
    opening.addEventListener('animationend', (event) => {
      if (event.target === opening) finish();
    });
    document.addEventListener('keydown', onKey);
    motion.addEventListener('change', finish);
    window.addEventListener('pagehide', finish);
    // Always reveal the page, including when media cannot load.
    timer = window.setTimeout(finish, 7600);
  })();
</script>

<style>
  :global(html.opening-active) { overflow: hidden; }
  :global(html.opening-pending .home-shell),
  :global(html.opening-active .home-shell) { visibility: hidden; }
  :global(html.opening-complete .home-shell) { animation: home-arrive 1.6s ease-in-out both; }
  .home-opening {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    isolation: isolate;
    background: #082634;
    animation: opening-reveal 7.2s ease-in-out both;
  }
  .home-opening[hidden] { display: none; }
  .opening-ocean, .opening-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .opening-ocean { object-fit: cover; filter: saturate(.65) brightness(.7); z-index: -2; }
  .opening-shade { background: linear-gradient(180deg, #061b3540, #06283718 45%, #051c3866); z-index: -1; }
  .opening-logo { width: min(580px, 78vw); height: auto; animation: opening-logo 1.4s .4s ease-in-out both; }
  .opening-skip {
    position: absolute;
    right: max(6%, env(safe-area-inset-right));
    bottom: max(32px, env(safe-area-inset-bottom));
    min-height: 44px;
    padding: 10px 8px;
    border: 0;
    background: transparent;
    color: #e2edf3;
    font: 11px 'Shippori Mincho', serif;
    letter-spacing: .18em;
    cursor: pointer;
  }
  .opening-skip span { margin-left: 12px; }
  @keyframes home-arrive {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes opening-logo {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes opening-reveal {
    0%, 76% { opacity: 1; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-opening { display: none; animation: none; }
    :global(html.opening-complete .home-shell) { animation: none; }
    .opening-logo, .opening-ocean { animation: none; }
  }
</style>
